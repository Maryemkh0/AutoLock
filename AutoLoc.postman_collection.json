	"item": [
		{
			"name": "Contrats",
			"item": [
				{
					"name": "1. Lister les contrats",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Statut 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/contrats",
							"host": ["{{baseUrl}}"],
							"path": ["contrats"]
						}
					}
				},
				{
					"name": "2. Consulter un contrat inexistant (404)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Statut 404 Not Found\", function () {",
									"    pm.response.to.have.status(404);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/contrats/9999",
							"host": ["{{baseUrl}}"],
							"path": ["contrats", "9999"]
						}
					}
				},
				{
					"name": "3. Créer un contrat",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Statut 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"var jsonData = pm.response.json();",
									"pm.environment.set(\"contratId\", jsonData.idContrat);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"dateSignature\": \"2026-11-02\",\n    \"montantTotal\": 480.00,\n    \"valide\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/contrats",
							"host": ["{{baseUrl}}"],
							"path": ["contrats"]
						}
					}
				},
				{
					"name": "4. Créer un contrat avec identifiant (400)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Statut 400 Bad Request\", function () {",
									"    pm.response.to.have.status(400);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"idContrat\": 5,\n    \"dateSignature\": \"2026-11-02\",\n    \"montantTotal\": 480.00,\n    \"valide\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/contrats",
							"host": ["{{baseUrl}}"],
							"path": ["contrats"]
						}
					}
				},
				{
					"name": "5. Créer un contrat avec ses paiements (Cascade PERSIST)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Statut 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"var jsonData = pm.response.json();",
									"pm.environment.set(\"contratCascadeId\", jsonData.idContrat);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"dateSignature\": \"2026-11-02\",\n    \"montantTotal\": 480.00,\n    \"valide\": true,\n    \"paiements\": [\n        {\n            \"montant\": 150.00,\n            \"datePaiement\": \"2026-11-02\",\n            \"modePaiement\": \"CARTE\"\n        },\n        {\n            \"montant\": 330.00,\n            \"datePaiement\": \"2026-11-06\",\n            \"modePaiement\": \"VIREMENT\"\n        }\n    ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/contrats",
							"host": ["{{baseUrl}}"],
							"path": ["contrats"]
						}
					}
				},
				{
					"name": "6. Modifier un contrat (200)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Statut 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var jsonData = pm.response.json();",
									"pm.test(\"Montant modifié\", function () {",
									"    pm.expect(jsonData.montantTotal).to.eql(520.00);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"dateSignature\": \"2026-11-02\",\n    \"montantTotal\": 520.00,\n    \"valide\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/contrats/{{contratId}}",
							"host": ["{{baseUrl}}"],
							"path": ["contrats", "{{contratId}}"]
						}
					}
				},
				{
					"name": "7. Modifier contrat montant négatif (400)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Statut 400 Bad Request\", function () {",
									"    pm.response.to.have.status(400);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"dateSignature\": \"2026-11-02\",\n    \"montantTotal\": -100.00,\n    \"valide\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/contrats/{{contratId}}",
							"host": ["{{baseUrl}}"],
							"path": ["contrats", "{{contratId}}"]
						}
					}
				},
				{
					"name": "8. Supprimer un contrat (204 Cascade REMOVE)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Statut 204 No Content\", function () {",
									"    pm.response.to.have.status(204);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/contrats/{{contratCascadeId}}",
							"host": ["{{baseUrl}}"],
							"path": ["contrats", "{{contratCascadeId}}"]
						}
					}
				}
			]
		},
